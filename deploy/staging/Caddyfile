# HTTPS for the API (through the gateway), the location service and the admin console. Certificates come from Let's Encrypt (Caddy falls back to ZeroSSL) and renew
# automatically. Hostnames are set in .env; without a domain use sslip.io, e.g. api.203-0-113-7.sslip.io.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options nosniff
	}
	log {
		output stdout
		format json
	}
}

{$API_HOST} {
	import common
	header Referrer-Policy no-referrer
	# Only health is public on actuator; everything else there stays internal.
	@actuator {
		path /actuator/*
		not path /actuator/health /actuator/health/*
	}
	respond @actuator 404
	request_body {
		max_size 24MB
	}
	# One host for all apps: the gateway routes to core-app and location-service.
	reverse_proxy api-gateway:8090
}

# Kept until the apps use API_HOST for pings too; then this block and LOCATION_HOST go.
{$LOCATION_HOST} {
	import common
	header Referrer-Policy no-referrer
	@actuator {
		path /actuator/*
		not path /actuator/health /actuator/health/*
	}
	respond @actuator 404
	# WebSocket upgrades are proxied automatically.
	reverse_proxy location-service:8081
}

{$CONSOLE_HOST} {
	import common
	header {
		# Map tiles: OpenStreetMap blocks tile requests without a Referer. Other sites get the origin only.
		Referrer-Policy strict-origin-when-cross-origin
		# Spring adds HSTS for the API; Next.js does not, so Caddy adds it here.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Document previews are same-origin <img>/<iframe>; no other site may frame the console.
		Content-Security-Policy "frame-ancestors 'self'"
		X-Frame-Options SAMEORIGIN
	}
	# Two-sided document uploads pass through the console to core-app.
	request_body {
		max_size 24MB
	}
	reverse_proxy web-console:3000
}
