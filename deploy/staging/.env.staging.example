# Staging configuration. On the droplet: copy to .env (chmod 600), then run ./generate-secrets.sh,
# which fills every empty secret below and never overwrites a value that is already set.
# .env is git-ignored. Never commit it.

# --- Hosts (no domain yet: sslip.io resolves api.<ip-with-dashes>.sslip.io to that IP) ---
API_HOST=
LOCATION_HOST=
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# --- Images (pushed by CI; IMAGE_TAG is a git commit SHA) ---
IMAGE_REPOSITORY=ghcr.io/channrith/scheduled-mobility
IMAGE_TAG=

# --- Test-environment behaviour ---
# Every phone logs in with this code. Staging holds test data only, never real personal data.
OTP_FIXED_CODE=1234
# Granted ADMIN on first start (while no ADMIN exists); ignored afterwards.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=Administrator
API_DOCS_ENABLED=true

# --- Document storage ---
# local: encrypted files in a Docker volume on the droplet (no off-site copy).
# s3: DigitalOcean Spaces, private bucket in SGP1; fill in the STORAGE_S3_* values below.
STORAGE_TYPE=local
STORAGE_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
STORAGE_S3_REGION=sgp1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- Nightly database backups (backup.sh + cron): a separate private bucket ---
# Not set up until Spaces exists; until then there are no backups (see docs/staging.md).
BACKUP_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
BACKUP_S3_REGION=sgp1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=14

# --- Memory (defaults fit a 1 vCPU / 2 GB droplet with a 2 GB swap file; see docs/staging.md) ---
# For a 4 GB droplet: CORE_APP_MEM_LIMIT=1g, CORE_APP_JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError,
# POSTGRES_MEM_LIMIT=768m, POSTGRES_SHARED_BUFFERS=128MB, RABBITMQ_MEM_LIMIT=384m, LOCATION_SERVICE_MEM_LIMIT=384m
CORE_APP_MEM_LIMIT=768m
CORE_APP_JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+ExitOnOutOfMemoryError
LOCATION_SERVICE_MEM_LIMIT=256m
LOCATION_SERVICE_JAVA_OPTS=-XX:MaxRAMPercentage=50 -XX:+ExitOnOutOfMemoryError
POSTGRES_MEM_LIMIT=384m
POSTGRES_SHARED_BUFFERS=64MB
RABBITMQ_MEM_LIMIT=320m
REDIS_MEM_LIMIT=96m
REDIS_MAXMEMORY=64mb
CADDY_MEM_LIMIT=128m

# --- Secrets: leave empty, generate-secrets.sh fills them ---
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
OTP_HMAC_SECRET=
IDEMPOTENCY_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=
PII_HASH_SECRET=
# RS256 PEM on one line (the app strips the BEGIN/END lines and whitespace).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
