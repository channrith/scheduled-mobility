# Staging configuration. On the droplet: copy to .env (chmod 600), then run ./generate-secrets.sh,
# which fills every empty secret below and never overwrites a value that is already set.
# .env is git-ignored. Never commit it.

# --- Hosts (no domain yet: sslip.io resolves api.<ip-with-dashes>.sslip.io to that IP) ---
API_HOST=
LOCATION_HOST=
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# --- Images (pushed by CI; IMAGE_TAG is a git commit SHA) ---
IMAGE_REPOSITORY=ghcr.io/channrith/scheduled-mobility
IMAGE_TAG=

# --- Test-environment behaviour ---
# Every phone logs in with this code. Staging holds test data only, never real personal data.
OTP_FIXED_CODE=1234
# Granted ADMIN on first start (while no ADMIN exists); ignored afterwards.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=Administrator
API_DOCS_ENABLED=true

# --- Document storage: DigitalOcean Spaces (private bucket, SGP1) ---
STORAGE_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
STORAGE_S3_REGION=sgp1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- Nightly database backups (backup.sh): a separate private bucket ---
BACKUP_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
BACKUP_S3_REGION=sgp1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_RETENTION_DAYS=14

# --- Secrets: leave empty, generate-secrets.sh fills them ---
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
OTP_HMAC_SECRET=
IDEMPOTENCY_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=
PII_HASH_SECRET=
# RS256 PEM on one line (the app strips the BEGIN/END lines and whitespace).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
