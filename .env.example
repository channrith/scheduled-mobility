# Copy to .env and adjust. .env is git-ignored. Never commit real secrets.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mobility
DB_USERNAME=mobility
DB_PASSWORD=mobility

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=mobility

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=mobility
RABBITMQ_PASSWORD=mobility

# OTP codes are stored as HMAC-SHA256(secret, phone:code). At least 32 characters.
OTP_HMAC_SECRET=local-dev-otp-secret-change-me-0123456789
# Test environments only: every phone logs in with this code instead of a random one (e.g. 1234).
# Anyone who knows a phone number can then log in as that user. Refused under a prod/production profile.
OTP_FIXED_CODE=

# Granted ADMIN at startup while no ADMIN exists yet (e.g. 012000001); ignored afterwards.
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=Administrator

# RS256 keys for access tokens (PEM; PKCS#8 private, X.509 public). Optional locally: the local
# profile generates a throwaway pair. Generate with (*.pem is git-ignored):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
#   openssl pkey -in jwt-private.pem -pubout -out jwt-public.pem
# Either point to the files (relative to the repo root)...
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
# ...or paste the PEM contents on one line. Do not set both forms.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# AES-256 key (base64 of 32 bytes) encrypting cached Idempotency-Key responses in Redis.
#   openssl rand -base64 32
IDEMPOTENCY_ENCRYPTION_KEY=bG9jYWwtZGV2LWlkZW1wb3RlbmN5LWtleS0zMmJ5dGU=

# Personal data (national ID, bank account, document files) is encrypted with this AES-256 key.
#   openssl rand -base64 32
PII_ENCRYPTION_KEY=bG9jYWwtZGV2LXBpaS1lbmNyeXB0aW9uLWtleS0zMmI=
# HMAC secret for blind indexes (duplicate national ID detection). At least 32 characters.
PII_HASH_SECRET=local-dev-pii-hash-secret-change-me-0123

# Document storage: local (filesystem) or s3 (any S3-compatible store). Encrypted by the app either way.
STORAGE_TYPE=local
# local: where uploaded documents are stored (relative to the repo root; git-ignored).
STORAGE_LOCAL_DIR=./var/storage
# s3: e.g. DigitalOcean Spaces. Leave the endpoint empty for AWS S3. The bucket must exist and be private.
# STORAGE_S3_ENDPOINT=https://sgp1.digitaloceanspaces.com
# STORAGE_S3_REGION=sgp1
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# Serve /swagger-ui.html and /v3/api-docs outside the local profile (never in production).
# API_DOCS_ENABLED=false
